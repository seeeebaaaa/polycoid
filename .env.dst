# False in prod
DEBUG=True
# polycoid.com in prod
PARENT_HOST=localhost:8000
# https in prod
HOST_SCHEME=http
# change in  prod
SECRET_KEY=your-secret-key
# Not necessary to keep the ip here, but it makes it easier to change
SERVER_IP=the-server-ip
# Database infos
DATABASE_NAME=name-of-db
# SECURITY WARNING: dont share name and password
DATABASE_USER=db-root-user
# dont change
DATABASE_PASSWORD=db-pw
# 
DATABASE_HOST=postgres_db
# '' in prod
DATABASE_PORT=5432

# tmdb api key
TMDB_API_KEY=tmdb-key

# email settings
EMAIL_HOST=smtp.xxxxxx.xxx
EMAIL_PORT=587
EMAIL_HOST_USER=xxx@xxx.xxx
EMAIL_HOST_PASSWORD=xxx